# PUBLIC browser endpoints. These values are compiled into Next.js at BUILD time.
# For another machine on your LAN, replace localhost with the Docker host IP and rebuild.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/demo
# NEVER put database passwords or Supabase secret/service-role keys in NEXT_PUBLIC_ variables.
