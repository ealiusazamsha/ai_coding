# Development defaults. All host ports may be overridden using PowerShell session variables.
# Compose: docker compose -f infra/docker-compose.yml up --build -d
AACP_API_HOST_PORT=8001
AACP_WEB_HOST_PORT=3000
# The NEXT_PUBLIC URLs are compiled when building the Next.js Docker image.
# They must match the address reachable by your browser, not Docker's service name.
AACP_PUBLIC_API_URL=http://localhost:8001
AACP_PUBLIC_WS_URL=ws://localhost:8001/ws/v1/demo
AACP_ALLOWED_ORIGINS=http://localhost:3000

# For cloud database operation, set AACP_DEMO_MODE=false in infra/.env
# while keeping private DATABASE_URL, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
# AACP_DEFAULT_TENANT_ID and AACP_OPERATOR_USER_IDS in services/api/.env.
# AACP_DEMO_MODE=false
# AACP_SUPABASE_PUBLIC_URL=https://bborikhazomedjzihyiv.supabase.co
# AACP_SUPABASE_PUBLIC_KEY=sb_publishable_YOUR_PUBLIC_KEY
# This is a public publishable key, not a privileged service-role key.
